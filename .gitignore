# Build output.
#
# The leading slash matters: it anchors each pattern to the repo root. Without
# it, `build/` also matched `app/build/` — the Build Your Own page — so that
# page was silently never committed, and 404'd on the deployed site while
# working perfectly on this machine.
node_modules/
/.next/
/out/
/build/
.DS_Store
*.pem

# env — never commit real keys
.env
.env.local
.env*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/

# Screenshots from automated browser checks. Working files, not site content —
# the photos the site actually uses live in public/photos/.
/shots/
