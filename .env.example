# ---------------------------------------------------------------------------
# Little Charmer — environment
#
# Copy this file to `.env.local` and fill in what you have.
# The public site works with NONE of these set; each one unlocks something.
# ---------------------------------------------------------------------------


# === ADMIN PANEL (/admin) ==================================================
# The password you type to sign in. Pick something long — this is the only
# thing standing between the internet and your site's text.
# Without it, /admin shows a message and can't be signed into at all.
ADMIN_PASSWORD=

# Signs the sign-in cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you leave it blank the password is used instead — fine locally, but set it
# properly in production.
ADMIN_SECRET=


# === SAVING ADMIN EDITS WHEN DEPLOYED ======================================
# Running locally, the admin writes straight to content/site.json and you can
# ignore this section entirely.
#
# Once deployed you MUST set these, because Vercel and Netlify give the site a
# throwaway filesystem — a saved file there silently disappears on the next
# deploy. With these set, saving commits to your repo instead, which persists
# AND redeploys the site automatically.
#
# Make the token at github.com/settings/personal-access-tokens/new
#   · Repository access: only your littlecharmer repo
#   · Permissions: Contents → Read and write
GITHUB_TOKEN=
GITHUB_REPO=edchristiandelarama/littlecharmer
GITHUB_BRANCH=main


# === ORDER EMAILS ==========================================================
# Optional. Without a key the order form still works — it hands the customer a
# pre-filled Messenger link and a pre-filled email instead of sending for them.
# Free tier at https://resend.com
RESEND_API_KEY=

# Where order emails go. Defaults to the email in the admin panel.
ORDER_EMAIL_TO=

# Until you verify your own domain with Resend, leave this as-is.
ORDER_EMAIL_FROM=Little Charmer <onboarding@resend.dev>


# === SITE ADDRESS ==========================================================
# Used for absolute links in Facebook/Messenger previews. Set once you have a
# domain, e.g. https://littlecharmer.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
